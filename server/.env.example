# REQUIRED — your Anthropic API key (https://console.anthropic.com). Put real values in .env.local, never commit them.
ANTHROPIC_API_KEY="sk-ant-..."

# ── Spend guards (USD). Defaults shown. The engine refuses to call the API past these. ──
AIX_REQUEST_MAX_USD=0.01     # hard ceiling for one reply including repair passes
AIX_SESSION_MAX_USD=0.25     # per chat session
AIX_DAILY_MAX_USD=2.00       # whole server, resets at UTC midnight

# ── Optional ──
# AIX_RATE_PER_MIN=30        # per-IP requests per minute on /api/chat and /api/mcp
# AIX_MCP_TOKEN=             # if set, /api/mcp requires "Authorization: Bearer <token>"
# AIX_ENABLE_SANDBOX=1       # enable the MCP execute_sandbox_code tool (off by default)
# AIX_CACHE=0                # disable the in-memory response cache
# AIX_MOCK=1                 # offline mock transport: no API calls, replies are labelled [MOCK]
# PORT=3000

# ── Accounts, credits and billing (front end = GitHub Pages, back end = this server) ──
AIX_ADMIN_TOKEN="change-me"            # your owner token: grant credits, export users.md
AIX_ALLOWED_ORIGINS="https://thecreator715.github.io"   # who may call this API from a browser
AIX_SIGNUP_CREDITS=0                   # free credits for new accounts
AIX_DATA_DIR="data"                    # accounts.json lives here (use a persistent disk)
STRIPE_WEBHOOK_SECRET="whsec_..."      # Stripe -> POST https://YOUR-SERVER/api/stripe/webhook (checkout.session.completed)
